{
  "name": "@kurrawongai/shacl-ui",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/shacl-ui.umd.cjs",
  "module": "./dist/shacl-ui.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/index": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kurrawong/shacl-ui.git"
  },
  "bugs": {
    "url": "https://github.com/kurrawong/shacl-ui/issues"
  },
  "homepage": "https://github.com/kurrawong/shacl-ui",
  "author": {
    "name": "Edmond Chuc",
    "email": "edmond@kurrawong.ai"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "shacl"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@comunica/query-sparql-rdfjs-lite": "^4.3.0",
    "@formkit/auto-animate": "^0.8.2",
    "@internationalized/date": "^3.8.2",
    "@rdfjs/term-set": "^2.0.3",
    "@vocabulary/dash": "^1.0.5",
    "@vocabulary/sh": "^1.1.6",
    "@vueuse/core": "^13.5.0",
    "class-variance-authority": "^0.7.1",
    "clownface": "^2.0.3",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.525.0",
    "n3": "^1.26.0",
    "rdf-ext": "^2.5.2",
    "rdf-validate-shacl": "^0.6.5",
    "reka-ui": "^2.3.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@storybook/addon-docs": "^9.0.16",
    "@storybook/builder-vite": "^9.0.16",
    "@storybook/vue3-vite": "^9.0.16",
    "@tailwindcss/vite": "^4.1.12",
    "@tsconfig/node22": "^22.0.2",
    "@types/clownface": "^2.0.10",
    "@types/jsdom": "^21.1.7",
    "@types/n3": "^1.26.0",
    "@types/node": "^22.15.32",
    "@types/rdf-ext": "^2.5.2",
    "@types/rdfjs__term-set": "^2.0.9",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-plugin-oxlint": "~1.1.0",
    "eslint-plugin-storybook": "^9.0.16",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.1.0",
    "prettier": "3.5.3",
    "storybook": "^9.0.16",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-libcss": "^1.1.2",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "vue-tsc": "^2.2.10"
  },
  "peerDependencies": {
    "vue": "^3.5.18"
  }
}
